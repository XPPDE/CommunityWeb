@page
@model CommunityWeb.Pages.AutorizationModel
@{
    ViewData["Title"] = "Авторизация";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Вход в Hub</h1>
        <p class="auth-subtitle">Авторизуйтесь, чтобы добавлять свои проекты</p>

        <form method="post">
            <!-- Поле Логина -->
            <div class="form-group">
                <label class="form-label" asp-for="Input.Username">Логин</label>
                <input asp-for="Input.Username" maxlength="30" pattern="[a-z0-9_]+" title="Только строчные латинские буквы, цифры и подчеркивание" placeholder="xppde" class="form-input" placeholder="Введите ваш логин" required />
            </div>

            <!-- Поле Пароля -->
            <div class="form-group">
                <label class="form-label" asp-for="Input.Password">Пароль</label>
                <input asp-for="Input.Password" maxlength="30" type="password" class="form-input" placeholder="••••••••" required />
            </div>

            <!-- Кнопка отправки формы -->
            <button type="submit" class="btn-submit">Войти</button>
        </form>
		<div class="auth-footer">
            <a asp-page="/Registration" class="btn-registеr">Зарегистрироваться</a>
        </div>
    </div>
</div>