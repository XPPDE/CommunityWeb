@page
@model CommunityWeb.Pages.AddProjectModel
@{
    ViewData["Title"] = "Добавить проект";
}

<style>
    /* Центрирование и ограничение ширины формы */
    .form-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 20px;
    }

    /* Стеклянная карточка формы */
    .form-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 550px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .form-title {
        font-size: 28px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-subtitle {
        font-size: 14px;
        color: #94a3b8;
        margin-bottom: 32px;
        font-weight: 300;
    }

    /* Группы полей ввода */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #cbd5e1;
    }

    .form-input {
        background-color: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 12px 16px;
        color: #ffffff;
        font-family: inherit;
        font-size: 15px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    /* Специфичный стиль для большого текстового поля описания */
    textarea.form-input {
        resize: vertical;
        min-height: 120px;
        line-height: 1.5;
    }

    .form-input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }

    /* Ссылка на демо/гитхаб — делаем подсказку тусклой */
    .field-hint {
        font-size: 12px;
        color: #64748b;
        margin-top: -4px;
    }

    /* Блок кнопок внизу формы */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    .btn-cancel {
        flex: 1;
        background-color: transparent;
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 14px;
        font-size: 15px;
        font-weight: 500;
        text-align: center;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

    .btn-cancel:hover {
        background-color: rgba(148, 163, 184, 0.05);
        color: #ffffff;
    }

    .btn-submit {
        flex: 2;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .btn-submit:active {
        transform: translateY(1px);
    }
</style>

<div class="form-wrapper">
    <div class="form-card">
        <h1 class="form-title"><span>🚀</span> Новый проект</h1>
        <p class="form-subtitle">Поделитесь своей разработкой с ребятами из коммьюнити</p>

        <form method="post">
            
            <!-- Название проекта -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.Title">Название проекта</label>
                <input asp-for="NewProject.Title" class="form-input" placeholder="Например: Свой Телеграм-бот или Агрегатор" required />
            </div>

            <!-- Описание проекта -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.Description">Описание</label>
                <textarea maxlength="3000" asp-for="NewProject.Description" class="form-input" placeholder="Расскажите, какой стек использовали, какие фичи реализовали и зачем создали этот проект..." required></textarea>
            </div>

            <!-- Ссылка на живой сайт / демо -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.LiveUrl">Ссылка на демо (Live URL)</label>
                <input asp-for="NewProject.LiveUrl" type="url" class="form-input" placeholder="https://myproject.ru" />
                <span class="field-hint">Необязательно. Ссылка, по которой проект можно пощупать вживую.</span>
            </div>

            <!-- Кнопки управления -->
            <div class="form-actions">
                <a asp-page="/Index" class="btn-cancel">Отмена</a>
                <button type="submit" class="btn-submit">Опубликовать проект</button>
            </div>

        </form>
    </div>
</div>
