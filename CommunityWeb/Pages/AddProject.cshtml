@page
@model CommunityWeb.Pages.AddProjectModel
@{
    ViewData["Title"] = "Добавить проект";
}

<div class="form-wrapper">
    <div class="form-card">
        <h1 class="form-title"><span>🚀</span> Новый проект</h1>
        <p class="form-subtitle">Поделитесь своей разработкой с ребятами из коммьюнити</p>

        <form method="post">
            
            <!-- Название проекта -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.Title">Название проекта</label>
                <input asp-for="NewProject.Title" class="form-input" placeholder="Например: Свой Телеграм-бот или Агрегатор" required />
            </div>

            <!-- Описание проекта -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.Description">Описание</label>
                <textarea maxlength="3000" asp-for="NewProject.Description" class="form-input" placeholder="Расскажите, какой стек использовали, какие фичи реализовали и зачем создали этот проект..." required></textarea>
            </div>

            <!-- Ссылка на живой сайт / демо -->
            <div class="form-group">
                <label class="form-label" asp-for="NewProject.LiveUrl">Ссылка на демо (Live URL)</label>
                <input asp-for="NewProject.LiveUrl" type="url" class="form-input" placeholder="https://myproject.ru" />
                <span class="field-hint">Необязательно. Ссылка, по которой проект можно пощупать вживую.</span>
            </div>

            <!-- Кнопки управления -->
            <div class="form-actions">
                <a asp-page="/Index" class="btn-cancel">Отмена</a>
                <button type="submit" class="btn-submit">Опубликовать проект</button>
            </div>

        </form>
    </div>
</div>
