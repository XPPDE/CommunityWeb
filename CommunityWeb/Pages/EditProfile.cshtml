@page
@model CommunityWeb.Pages.EditProfileModel
@{
    ViewData["Title"] = "Настройка профиля";
}

<style>
    /* Центрирование и каркас формы */
    .edit-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        padding: 20px;
    }

    .edit-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 550px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .edit-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .edit-subtitle {
        font-size: 14px;
        color: #94a3b8;
        margin-bottom: 32px;
        font-weight: 300;
    }

    /* Элементы форм */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #cbd5e1;
    }

    .form-input {
        background-color: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 12px 16px;
        color: #ffffff;
        font-family: inherit;
        font-size: 15px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    textarea.form-input {
        min-height: 120px;
        resize: vertical;
        line-height: 1.5;
    }

    .form-input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }

    .field-hint {
        font-size: 12px;
        color: #64748b;
        margin-top: -4px;
    }

    /* Кастомная зона загрузки файла */
    .file-upload-zone {
        background-color: rgba(15, 23, 42, 0.4);
        border: 2px dashed rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        transition: border-color 0.2s ease, background-color 0.2s ease;
        cursor: pointer;
    }

    .file-upload-zone:hover {
        border-color: #10b981;
        background-color: rgba(16, 185, 129, 0.02);
    }

    .file-input-native {
        color: #94a3b8;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
    }

    /* Ряд кнопок управления */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    .btn-cancel {
        flex: 1;
        background-color: transparent;
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 14px;
        font-size: 15px;
        font-weight: 500;
        text-align: center;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

    .btn-cancel:hover {
        background-color: rgba(148, 163, 184, 0.05);
        color: #ffffff;
    }

    .btn-save {
        flex: 2;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-save:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .btn-save:active {
        transform: translateY(1px);
    }
</style>

<div class="edit-wrapper">
    <div class="edit-card">
        <h1 class="edit-title"><span>⚙️</span> Личный кабинет</h1>
        <p class="edit-subtitle">Настройте свой профиль в нашей межгалактической империи</p>

        <!-- ВАЖНО: enctype="multipart/form-data" обязателен для работы файлов! -->
        <form method="post">
            
            <div class="form-group">
                <label class="form-label" asp-for="InputModel.Name">Отображаемое имя</label>
                <input asp-for="InputModel.Name" type="text" class="form-input" placeholder="Например: XPDDE" />
                <span class="field-hint">Обязательно</span>
            </div>

            <!-- Загрузка новой аватарки -->
            <div class="form-group">
                <label class="form-label" asp-for="InputModel.AvatarUrl">Аватарка: Url на картинку из интернета</label>
                <input asp-for="InputModel.AvatarUrl" type="text" class="form-input" placeholder="Например: https://top-site/monkey.png"/>
                <span class="field-hint">Оптимально</span>
            </div>

            <!-- Блок О себе -->
            <div class="form-group">
                <label class="form-label" asp-for="InputModel.Bio">Рассказ о себе (Bio)</label>
                <!-- Текст с переносами строк white-space обработается как надо -->
                <textarea asp-for="InputModel.Bio" class="form-input" placeholder="Расскажите о своем стеке, пет-проектах или просто напишите пару ламповых слов..."></textarea>
            </div>

            <!-- Юзернейм Телеграм-канала -->
            <div class="form-group">
                <label class="form-label" asp-for="InputModel.TelegramChannel">Ваш Telegram-канал</label>
                <input asp-for="InputModel.TelegramChannel" type="text" class="form-input" placeholder="Например: my_dev_notes (без знака @@)" />
                <span class="field-hint">Нужен для автоматического парсинга ваших постов в ленту сайта.</span>
            </div>

            <!-- Кнопки действий -->
            <div class="form-actions">
                <a asp-page="/Index" class="btn-cancel">Отмена</a>
                <button type="submit" class="btn-save">Сохранить изменения</button>
            </div>

        </form>
    </div>
</div>
