@page
@model CommunityWeb.Pages.BlogModel
@{
    ViewData["Title"] = "Лента постов";
}

<style>

    /* Сетка и заголовки проектов */
    .posts-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(148, 163, 184, 0.1);
        padding-bottom: 16px;
        margin-bottom: 24px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .no-data {
        grid-column: 1 / -1;
        background-color: rgba(30, 41, 59, 0.4);
        border: 1px dashed #334155;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #94a3b8;
    }

    /* Сетка постов */
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(520px, 1fr));
        gap: 24px;
    }

    .no-posts {
        grid-column: 1 / -1;
        background-color: rgba(30, 41, 59, 0.4);
        border: 1px dashed #334155;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #94a3b8;
    }

    .post-card {
        background-color: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(51, 65, 85, 0.6);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s ease, border-color 0.3s ease;
        min-height: 400px;
    }

        .post-card:hover {
            transform: translateY(-4px);
            border-color: #475569;
        }

    .post-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 12px 0;
        transition: color 0.2s ease;
    }

    .post-card:hover .post-title {
        color: #10b981;
    }

    .post-desc {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 300;
        margin-bottom: 24px;
        white-space: pre-line;
        /* display: -webkit-box;
            -webkit-line-clamp: none;
            -webkit-box-orient: vertical; */
        overflow: hidden;
    }

    .post-footer {
        margin-top: auto;
        padding-top: 16px;
        border-t: 1px solid rgba(51, 65, 85, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #64748b;
    }

    .author-link {
        color: #10b981;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }

    .author-link:hover {
        color: #34d399;
    }
</style>

<div class="main-hub">
    <!-- Раздел с проектами -->
    <div class="projects-section">
        <div class="posts-header">
            <h2 class="section-title">🛠️ Посты сообщества</h2>
        </div>

        <div class="posts-grid">
            @if (Model.Posts == null || !Model.Posts.Any())
            {
                <div class="no-data">
                    База данных пока пуста. Загляните позже или добавьте проект первым!
                </div>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    <div class="post-card">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <h3 class="post-title">@post.Title</h3>
                            </div>
                            <p class="post-desc">@post.Content</p>
                        </div>

                        <div class="post-footer">
                            <span>@post.CreatedAt.ToString()</span>

                            <span style="color: #64748b;">
                                Автор:
                                <a asp-page="/Profile" asp-route-id="@post.AuthorId" class="author-link">
                                    @post.Author?.Username
                                </a>
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

