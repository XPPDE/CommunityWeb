@page "{id:int}"

@model CommunityWeb.Pages.ProfileModel
@{
    ViewData["Title"] = $"Профиль {Model.Profile.Username}";
}

<div class="profile-container">

    <a asp-page="/Index" class="back-link">
        <span>&larr;</span> Назад к проектам
    </a>

    <!-- КАРТОЧКА ПРОФИЛЯ -->
    <div class="profile-card">
        <div class="avatar-wrapper">
            <div class="avatar-glow"></div>

            @if (!string.IsNullOrWhiteSpace(Model.Profile.AvatarUrl))
            {
                FileInfo fileInfo = new FileInfo(Model.Profile.AvatarUrl);
                if (fileInfo.Extension == ".png")
                {
					<img src="@Model.Profile.AvatarUrl" alt="" class="avatar-img" />
                }
                else if (fileInfo.Extension == ".mp4")
                {
                    <video src="@Model.Profile.AvatarUrl" autoplay loop muted alt="" class="avatar-img"/>
                }
                else
                {
                    <img src="@Model.Profile.AvatarUrl" alt="" class="avatar-img" />
                }

                
            }
            else
            {
                <div class="avatar-placeholder">
                    @(!string.IsNullOrWhiteSpace(Model.Profile.Username)
                        ? Model.Profile.Username.Trim().Substring(0, 1).ToUpper()
                        : "U")
                </div>
            }
        </div>

        <div class="profile-info">
            <div class="profile-header-row">
                <h1 class="profile-name">@Model.Profile.Name</h1>
                <span class="profile-badge">@Model.Profile.Role</span>

                <!-- ФУНКЦИОНАЛ ТОЛЬКО ДЛЯ ВЛАДЕЛЬЦА ПРОФИЛЯ -->
                @if (Model.IsOwner)
                {
                    <a asp-page="/EditProfile" class="btn-edit-profile">✏️ Редактировать профиль</a>
                }
            </div>
            <p class="profile-username">@@@Model.Profile.Username</p>

            @if (Model.Profile.Id == 9)
            {
                <p>
                    💩💩💩💩💩💩💩
                </p>
                <video class="avatar-img" src="https://media.tenor.com/bxKh6CrdkFEAAAPo/ai-toilet.mp4" loop autoplay muted />
            }

            <p class="profile-bio">
                
                @(string.IsNullOrEmpty(Model.Profile.Bio) ? "Этот разработчик еще не заполнил блок 'о себе'." : Model.Profile.Bio)
            </p>

            <div class="profile-badges-row">
                @if (!string.IsNullOrEmpty(Model.Profile.TelegramChannel))
                {
                    <a href="https://t.me/@Model.Profile.TelegramChannel" target="_blank" class="tg-link">
                        <span>✈</span> Telegram
                    </a>
                }

                <!-- ЕСЛИ ВЛАДЕЛЕЦ И НЕ ПРИВЯЗАЛ ТГ — ПРЕДЛОЖИМ ПРИВЯЗАТЬ -->
                @if (Model.IsOwner && string.IsNullOrEmpty(Model.Profile.TelegramChannel))
                {
                    <a asp-page="/EditProfile" class="tg-link" style="color: #e2e8f0; border-color: #475569; background: transparent;">
                        ➕ Привязать ТГ-канал для автоленты
                    </a>
                }

                <a class="tg-link" href="#posts">Посты</a>
                <a class="tg-link" href="#projects">Проекты</a>

                <div class="stats-badge">
                    <span>🛠️</span> Проектов: @Model.Projects.Count
                </div>
            </div>
        </div>
    </div>


    <!-- БЛОК ПОСТОВ -->
    <div class="post-section" id="posts">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="section-title" style="margin-bottom: 0;">
                <span>💻</span> Блог автора
            </h2>

            <!-- ВЛАДЕЛЕЦ ПРОФИЛЯ МОЖЕТ ПРЯМО ОТСЮДА БЫСТРО ДОБАВИТЬ ПОСТ -->
            @if (Model.IsOwner)
            {
                <a asp-page="/AddPost" class="btn-edit-profile" style="color: #10b981; border-color: rgba(16, 185, 129, 0.3);">
                    + Добавить пост
                </a>
            }
        </div>

        <div class="posts-grid">
            @if (!Model.Posts.Any())
            {
                <div class="no-posts">
                    У этого участника пока нет опубликованных постов.
                </div>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    
                    <div class="post-card">
                        <a asp-page="/PostDetails" asp-route-id="@post.Id" style="text-decoration: none;">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <h3 class="post-title">@post.Title</h3>

                                    <!-- ВЛАДЕЛЕЦ МОЖЕТ УДАЛЯТЬ ИЛИ РЕДАКТИРОВАТЬ СВОИ ПРОЕКТЫ -->
                                    @if (Model.IsOwner)
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <a asp-page="/EditPost" asp-route-id="@post.Id" style="text-decoration: none; font-size: 14px;">⚙️</a>
											@*  <a href="#" style="text-decoration: none; font-size: 14px;">❌</a> *@
                                        </div>
                                    }
                                </div>
                                <p class="post-desc">@post.Content</p>
                            </div>

                            <div class="post-footer">
                                <span>@post.CreatedAt.ToString()</span>
                            </div>
                        </a>
                    </div>
                   
                }
            }
        </div>
    </div>

	<hr class="vertical-line" />

    <!-- БЛОК ПРОЕКТОВ -->
    <div class="projects-section" id="projects">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="section-title" style="margin-bottom: 0;">
                <span>💻</span> Рабочий стол автора
            </h2>

            <!-- ВЛАДЕЛЕЦ ПРОФИЛЯ МОЖЕТ ПРЯМО ОТСЮДА БЫСТРО ДОБАВИТЬ ПРОЕКТ -->
            @if (Model.IsOwner)
            {
                <a asp-page="/AddProject" class="btn-edit-profile" style="color: #10b981; border-color: rgba(16, 185, 129, 0.3);">
                    + Добавить проект
                </a>
            }
        </div>


        <div class="projects-grid">
            @if (!Model.Projects.Any())
            {
                <div class="no-projects">
                    У этого участника пока нет опубликованных проектов.
                </div>
            }
            else
            {
                @foreach (var project in Model.Projects)
                {
                    <div class="project-card">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <h3 class="project-title">@project.Title</h3>

                                <!-- ВЛАДЕЛЕЦ МОЖЕТ УДАЛЯТЬ ИЛИ РЕДАКТИРОВАТЬ СВОИ ПРОЕКТЫ -->
                                @if (Model.IsOwner)
                                {
                                    <div style="display: flex; gap: 8px;">
                                        <a href="#" style="text-decoration: none; font-size: 14px;">⚙️</a>
                                        <a href="#" style="text-decoration: none; font-size: 14px;">❌</a>
                                    </div>
                                }
                            </div>
                            <p class="project-desc">@project.Description</p>
                        </div>

                        <div class="project-footer">
                            <span>@project.CreatedAt.ToString()</span>
                            @if (!string.IsNullOrEmpty(project.LiveUrl))
                            {
                                <a href="@project.LiveUrl" target="_blank" class="demo-link">
                                    Открыть демо &rarr;
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
