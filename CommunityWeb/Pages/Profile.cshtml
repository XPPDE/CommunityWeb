@page "{id:int}"

@model CommunityWeb.Pages.ProfileModel
@{
    ViewData["Title"] = $"Профиль {Model.Profile.Name}";
}

<style>
    /* Основные стили страницы профиля */
    .profile-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 24px;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: #34d399;
    }

    /* Главная карточка автора */
    .profile-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: row;
        gap: 32px;
        align-items: flex-start;
        margin-bottom: 48px;
    }

    /* Контейнер аватарки с неоновым свечением */
    .avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .avatar-glow {
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        border-radius: 50%;
        z-index: 1;
        opacity: 0.4;
        filter: blur(8px);
        transition: opacity 0.3s ease;
    }

    .avatar-wrapper:hover .avatar-glow {
        opacity: 0.7;
    }

    .avatar-img {
        position: relative;
        z-index: 2;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #1e293b;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    }

    .avatar-placeholder {
        position: relative;
        z-index: 2;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background-color: #334155;
        border: 4px solid #1e293b;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 56px;
        font-weight: 700;
        color: #e2e8f0;
        user-select: none;
    }

    /* Текстовая информация профиля */
    .profile-info {
        flex-grow: 1;
    }

    .profile-header-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .profile-name {
        font-size: 30px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
    }

    .profile-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 12px;
        font-weight: 600;
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .profile-username {
        color: #94a3b8;
        font-size: 14px;
        margin: 4px 0 16px 0;
    }

    .profile-bio {
        color: #cbd5e1;
        font-size: 16px;
        font-weight: 300;
        line-height: 1.6;
        margin-bottom: 24px;
        max-width: 700px;
        white-space: pre-line;
    }

    /* Блоки ссылок и тегов */
    .profile-badges-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .tg-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: rgba(14, 165, 233, 0.1);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.2);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .tg-link:hover {
        background-color: rgba(14, 165, 233, 0.2);
    }

    .stats-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: rgba(51, 65, 85, 0.4);
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
    }

    /* Сетка постов */
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .no-posts {
        grid-column: 1 / -1;
        background-color: rgba(30, 41, 59, 0.4);
        border: 1px dashed #334155;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #94a3b8;
    }

    .post-card {
        background-color: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(51, 65, 85, 0.6);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s ease, border-color 0.3s ease;
        min-height: 400px;
    }

        .post-card:hover {
            transform: translateY(-4px);
            border-color: #475569;
        }

    .post-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 12px 0;
        transition: color 0.2s ease;
    }

    .post-card:hover .post-title {
        color: #10b981;
    }

    .post-desc {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 300;
        margin-bottom: 24px;
        white-space: pre-line;
        /* display: -webkit-box;
        -webkit-line-clamp: none;
        -webkit-box-orient: vertical; */
        overflow: hidden;
    }

    .post-footer {
        margin-top: auto;
        padding-top: 16px;
        border-t: 1px solid rgba(51, 65, 85, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #64748b;
    }

    /* Сетка проектов */
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .no-projects {
        grid-column: 1 / -1;
        background-color: rgba(30, 41, 59, 0.4);
        border: 1px dashed #334155;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #94a3b8;
    }

    .project-card {
        background-color: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(51, 65, 85, 0.6);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-4px);
        border-color: #475569;
    }

    .project-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 12px 0;
        transition: color 0.2s ease;
    }

    .project-card:hover .project-title {
        color: #10b981;
    }

    .project-desc {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 300;
        margin-bottom: 24px;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-footer {
        margin-top: auto;
        padding-top: 16px;
        border-t: 1px solid rgba(51, 65, 85, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #64748b;
    }

    .demo-link {
        color: #10b981;
        font-weight: 500;
        text-decoration: none;
    }

    .demo-link:hover {
        text-decoration: underline;
    }

    /* Адаптивность для мобильных устройств */
    @@media (max-width: 768px) {
        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 24px;
        }

        .profile-header-row {
            justify-content: center;
        }

        .profile-badges-row {
            justify-content: center;
        }
    }
    /* Добавим один новый стиль для кнопки редактирования */
    .btn-edit-profile {
        background-color: transparent;
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s;
        cursor: pointer;
    }

    .btn-edit-profile:hover {
        background-color: rgba(14, 165, 233, 0.1);
        border-color: #38bdf8;
    }

    .vertical-line {
        background-color: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(14, 165, 233, 0.3);
        height: 5px;
        margin: 10px;
    }
</style>

<div class="profile-container">

    <a asp-page="/Index" class="back-link">
        <span>&larr;</span> Назад к проектам
    </a>

    <!-- КАРТОЧКА ПРОФИЛЯ -->
    <div class="profile-card">
        <div class="avatar-wrapper">
            <div class="avatar-glow"></div>

            @if (!string.IsNullOrWhiteSpace(Model.Profile.AvatarUrl))
            {
                <img src="@Model.Profile.AvatarUrl" alt="" class="avatar-img" />
            }
            else
            {
                <div class="avatar-placeholder">
                    @(!string.IsNullOrWhiteSpace(Model.Profile.Name)
                        ? Model.Profile.Name.Trim().Substring(0, 1).ToUpper()
                        : "U")
                </div>
            }
        </div>

        <div class="profile-info">
            <div class="profile-header-row">
                <h1 class="profile-name">@Model.Profile.Name</h1>
                <span class="profile-badge">@Model.Profile.Role</span>

                <!-- ФУНКЦИОНАЛ ТОЛЬКО ДЛЯ ВЛАДЕЛЬЦА ПРОФИЛЯ -->
                @if (Model.IsOwner)
                {
                    <a asp-page="/EditProfile" class="btn-edit-profile">✏️ Редактировать профиль</a>
                }
            </div>
            <p class="profile-username">@@@Model.Profile.Username</p>

            <p class="profile-bio">
                @(string.IsNullOrEmpty(Model.Profile.Bio) ? "Этот разработчик еще не заполнил блок 'о себе'." : Model.Profile.Bio)
            </p>

            <div class="profile-badges-row">
                @if (!string.IsNullOrEmpty(Model.Profile.TelegramChannel))
                {
                    <a href="https://t.me/@Model.Profile.TelegramChannel" target="_blank" class="tg-link">
                        <span>✈</span> @Model.Profile.TelegramChannel
                    </a>
                }

                <!-- ЕСЛИ ВЛАДЕЛЕЦ И НЕ ПРИВЯЗАЛ ТГ — ПРЕДЛОЖИМ ПРИВЯЗАТЬ -->
                @if (Model.IsOwner && string.IsNullOrEmpty(Model.Profile.TelegramChannel))
                {
                    <a asp-page="/EditProfile" class="tg-link" style="color: #e2e8f0; border-color: #475569; background: transparent;">
                        ➕ Привязать ТГ-канал для автоленты
                    </a>
                }

                <div class="stats-badge">
                    <span>🛠️</span> Проектов: @Model.Projects.Count
                </div>
            </div>
        </div>
    </div>


    <!-- БЛОК ПОСТОВ -->
    <div class="post-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="section-title" style="margin-bottom: 0;">
                <span>💻</span> Блог автора
            </h2>

            <!-- ВЛАДЕЛЕЦ ПРОФИЛЯ МОЖЕТ ПРЯМО ОТСЮДА БЫСТРО ДОБАВИТЬ ПОСТ -->
            @if (Model.IsOwner)
            {
                <a asp-page="/AddPost" class="btn-edit-profile" style="color: #10b981; border-color: rgba(16, 185, 129, 0.3);">
                    + Добавить пост
                </a>
            }
        </div>

        <div class="posts-grid">
            @if (!Model.Projects.Any())
            {
                <div class="no-posts">
                    У этого участника пока нет опубликованных постов.
                </div>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    <div class="post-card">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <h3 class="post-title">@post.Title</h3>

                                <!-- ВЛАДЕЛЕЦ МОЖЕТ УДАЛЯТЬ ИЛИ РЕДАКТИРОВАТЬ СВОИ ПРОЕКТЫ -->
                                @if (Model.IsOwner)
                                {
                                    <div style="display: flex; gap: 8px;">
                                        <a href="#" style="text-decoration: none; font-size: 14px;">⚙️</a>
                                        <a href="#" style="text-decoration: none; font-size: 14px;">❌</a>
                                    </div>
                                }
                            </div>
                            <p class="post-desc">@post.Content</p>
                        </div>

                        <div class="post-footer">
                            <span>@post.CreatedAt.ToString()</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

	<hr class="vertical-line" />

    <!-- БЛОК ПРОЕКТОВ -->
    <div class="projects-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="section-title" style="margin-bottom: 0;">
                <span>💻</span> Рабочий стол автора
            </h2>

            <!-- ВЛАДЕЛЕЦ ПРОФИЛЯ МОЖЕТ ПРЯМО ОТСЮДА БЫСТРО ДОБАВИТЬ ПРОЕКТ -->
            @if (Model.IsOwner)
            {
                <a asp-page="/AddProject" class="btn-edit-profile" style="color: #10b981; border-color: rgba(16, 185, 129, 0.3);">
                    + Добавить проект
                </a>
            }
        </div>


        <div class="projects-grid">
            @if (!Model.Projects.Any())
            {
                <div class="no-projects">
                    У этого участника пока нет опубликованных проектов.
                </div>
            }
            else
            {
                @foreach (var project in Model.Projects)
                {
                    <div class="project-card">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <h3 class="project-title">@project.Title</h3>

                                <!-- ВЛАДЕЛЕЦ МОЖЕТ УДАЛЯТЬ ИЛИ РЕДАКТИРОВАТЬ СВОИ ПРОЕКТЫ -->
                                @if (Model.IsOwner)
                                {
                                    <div style="display: flex; gap: 8px;">
                                        <a href="#" style="text-decoration: none; font-size: 14px;">⚙️</a>
                                        <a href="#" style="text-decoration: none; font-size: 14px;">❌</a>
                                    </div>
                                }
                            </div>
                            <p class="project-desc">@project.Description</p>
                        </div>

                        <div class="project-footer">
                            <span>@project.CreatedAt.ToString()</span>
                            @if (!string.IsNullOrEmpty(project.LiveUrl))
                            {
                                <a href="@project.LiveUrl" target="_blank" class="demo-link">
                                    Открыть демо &rarr;
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
