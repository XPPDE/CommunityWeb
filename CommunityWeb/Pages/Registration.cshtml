@page
@model CommunityWeb.Pages.RegistrationModel
@{
    ViewData["Title"] = "Регистрация";
}

<style>
    /* Контейнер для центрирования формы по центру экрана */
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh; /* Чтобы окно было по центру контентной зоны */
        padding: 20px;
    }

    /* Стеклянная карточка формы */
    .auth-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .auth-title {
        font-size: 28px;
        font-weight: 800;
        color: #ffffff;
        text-align: center;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        font-size: 14px;
        color: #94a3b8;
        text-align: center;
        margin-bottom: 32px;
        font-weight: 300;
    }

    /* Стилизация групп полей ввода */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 500;
        color: #cbd5e1;
    }

    .form-input {
        background-color: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 12px 16px;
        color: #ffffff;
        font-family: inherit;
        font-size: 15px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    /* Эффект свечения при клике на поле ввода */
    .form-input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }

    /* Мощная градиентная кнопка отправки */
    .btn-submit {
        width: 100%;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 16px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        margin-top: 12px;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .btn-submit:active {
        transform: translateY(1px);
    }

    /* Стиль самой ссылки/кнопки регистрации */
    .btn-register {
        color: #10b981;
        font-weight: 600;
        text-decoration: none;
        margin-left: 6px;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
        font-family: inherit;
    }

    .auth-footer {
        margin-top: 24px;
        text-align: center;
        font-size: 14px;
        color: #94a3b8;
    }

    .btn-register:hover {
        color: #34d399;
        border-color: #34d399;
    }

    .btn-register:active {
        color: #059669;
        border-color: #059669;
    }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Регитрация в Hub</h1>
        <p class="auth-subtitle">Зарегистрируйтесь, чтобы добавлять свои проекты</p>

        <form method="post">
            <!-- Поле Логина -->
            <div class="form-group">
                <label class="form-label" asp-for="Input.Username">Логин</label>
                <input asp-for="Input.Username" maxlength="30" pattern="[a-z0-9_]+" title="Только строчные латинские буквы, цифры и подчеркивание" placeholder="xppde" class="form-input" placeholder="Введите ваш логин" required />
            </div>

            <!-- Поле Пароля -->
            <div class="form-group">
                <label class="form-label" asp-for="Input.Password">Пароль</label>
                <input asp-for="Input.Password" maxlength="30" type="password" class="form-input" placeholder="••••••••" required />
            </div>
            <!-- Поле Пароля -->
            <div class="form-group">
                <label class="form-label" asp-for="Input.RepeatPassword">Повторите пароль</label>
                <input asp-for="Input.RepeatPassword" maxlength="30" type="password" class="form-input" placeholder="••••••••" required />
            </div>

            <!-- Кнопка отправки формы -->
            <button type="submit" class="btn-submit">Зарегистрироваться</button>
        </form>
    </div>
</div>