@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Наше Коммьюнити</title>

    <!-- Подключаем качественный шрифт Inter -->
    <link href="https://googleapis.com" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">

</head>
<body>

    <!-- Шапка (Header) -->
    <header class="site-header">
        <div class="header-container">
            <a asp-page="/Index" class="site-logo">COMMUNITY HUB</a>
            <nav class="site-nav">
                <a asp-page="/Index" class="nav-link">Проекты</a>
                <a asp-page="/Blog" class="nav-link">Лента постов</a>
                <a asp-page="/Users" class="nav-link">Участники</a>
                @if (User.Identity!.IsAuthenticated)
                {
                    var userId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);

                    <a asp-page="/Profile" asp-route-id="@userId" class="nav-link">@User.Identity.Name</a>
                    <a asp-page="/Logout" class="nav-link-logout">Выйти</a>
                    
                }
                else
                {
                    <a asp-page="/Autorization" class="nav-link">Войти</a>
                }
                <button id="theme-toggle" class="nav-link" style="background: none; border: none; cursor: pointer;" title="Сменить тему"/>
                    🌓
            </nav>
        </div>
    </header>

    <!-- Основное содержимое страницы -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Подвал (Footer) -->
    <footer class="site-footer">
        <div class="header-container" style="justify-content: center;">
            <p>&copy; @DateTime.Now.Year — Создано для нашего круга друзей</p>
        </div>
    </footer>

     <!-- ВАЖНО: Сначала подключаем EasyMDE JS, потом рендерим скрипты страниц -->
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const toggleBtn = document.getElementById('theme-toggle');
                const body = document.body;

                // 1. Вспоминаем тему при загрузке страницы
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'light') {
                    body.classList.add('light-theme');
                }

                // 2. Обработчик клика
                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function () {
                        body.classList.toggle('light-theme');

                        // 3. Сохраняем выбор
                        if (body.classList.contains('light-theme')) {
                            localStorage.setItem('theme', 'light');
                        } else {
                            localStorage.setItem('theme', 'dark');
                        }
                    });
                }
            });
    </script>

</body>
</html>
