@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<style>
    /* Стили для контента главной страницы */
    .hero-section {
        text-align: center;
        margin-bottom: 48px;
        padding: 24px 0;
    }

    .hero-title {
        font-size: 40px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin-bottom: 12px;
    }

    .hero-subtitle {
        color: #94a3b8;
        font-size: 16px;
        font-weight: 300;
        margin-bottom: 24px;
    }

    /* Стили кнопок */
    .btn-auth {
        display: inline-block;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        color: #ffffff;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        padding: 12px 32px;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
        }

    .btn-logout {
        display: inline-block;
        background-color: transparent;
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
        font-weight: 500;
        font-size: 14px;
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 10px;
        transition: background-color 0.2s, border-color 0.2s;
        cursor: pointer;
    }

        .btn-logout:hover {
            background-color: rgba(239, 68, 68, 0.1);
            border-color: #ef4444;
        }

    .btn-add-project {
        display: inline-block;
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 12px;
        transition: background-color 0.2s, border-color 0.2s;
    }

        .btn-add-project:hover {
            background-color: rgba(16, 185, 129, 0.2);
            border-color: #10b981;
        }

    /* Контейнер приветствия авторизованного юзера */
    .welcome-user-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .welcome-text {
        font-size: 18px;
        color: #e2e8f0;
        font-weight: 500;
    }

    .welcome-name {
        color: #10b981;
        font-weight: 700;
    }

    /* Сетка и заголовки проектов */
    .projects-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(148, 163, 184, 0.1);
        padding-bottom: 16px;
        margin-bottom: 24px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .no-data {
        grid-column: 1 / -1;
        background-color: rgba(30, 41, 59, 0.4);
        border: 1px dashed #334155;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #94a3b8;
    }

    /* Карточки проектов */
    .project-card {
        background-color: #1e293b;
        border: 1px solid rgba(148, 163, 184, 0.1);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

        .project-card:hover {
            transform: translateY(-4px);
            border-color: #334155;
        }

    .project-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .project-desc {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 300;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-footer {
        padding-top: 14px;
        border-top: 1px solid rgba(51, 65, 85, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
    }

    .author-link {
        color: #10b981;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }

    .author-link:hover {
        color: #34d399;
    }

    .demo-link {
        color: #38bdf8;
        text-decoration: none;
        font-weight: 500;
    }

        .demo-link:hover {
            text-decoration: underline;
        }
</style>

<div class="main-hub">
    <!-- Приветственный блок (Динамический) -->
    <div class="hero-section">
        <h1 class="hero-title">Welcome to Our Community!</h1>
        <p class="hero-subtitle">Пространство для наших общих проектов, идей и лампового общения</p>

        @if (User.Identity is { IsAuthenticated: true })
        {
            <div class="welcome-user-box">
                <span class="welcome-text">Вы вошли как <span class="welcome-name">@User.Identity.Name</span></span>

                <div style="display: flex; gap: 12px; margin-top: 8px;">
                    <!-- КНОПКА ПЕРЕХОДА В СВОЙ ПРОФИЛЬ -->
                    <a asp-page="/Profile" asp-route-id="@Model.CurrentUserId" class="btn-auth" style="padding: 8px 20px; font-size: 14px;">Мой профиль</a>

                    <a asp-page="/Logout" class="btn-logout">Выйти из системы</a>
                </div>
            </div>
        }
        else
        {
            <a asp-page="/Autorization" class="btn-auth">Войти в аккаунт</a>
        }
    </div>

    <!-- Раздел с проектами -->
    <div class="projects-section">
        <div class="projects-header">
            <h2 class="section-title">🛠️ Разработки сообщества</h2>           
        </div>

        <div class="projects-grid">
            @if (Model.Projects == null || !Model.Projects.Any())
            {
                <div class="no-data">
                    База данных пока пуста. Загляните позже или добавьте проект первым!
                </div>
            }
            else
            {
                @foreach (var project in Model.Projects)
                {
                    <div class="project-card">
                        <div>
                            <h3 class="project-title">@project.Title</h3>
                            <p class="project-desc">@project.Description</p>
                        </div>

                        <div class="project-footer">
                            <span style="color: #64748b;">
                                Автор:
                                <a asp-page="/Profile" asp-route-id="@project.AuthorId" class="author-link">
                                    @project.Author?.Username
                                </a>
                            </span>
                            @if (!string.IsNullOrEmpty(project.LiveUrl))
                            {
                                <a href="@project.LiveUrl" target="_blank" class="demo-link">Demo &rarr;</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
